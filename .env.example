# Copy to .env and edit. NEVER commit the real .env file.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# First administrator, created on startup if no admin exists yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Any SQLAlchemy URL works (PostgreSQL, MySQL ...). Default: SQLite file in ./data
# DATABASE_URL=sqlite:///./data/blood_donor.db

# TOKEN_EXPIRE_MINUTES=120
